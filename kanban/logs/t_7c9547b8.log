+  function hitung_hpp_otomatis(){
+    var total_hpp = parseFloat($('#total_hpp_text').val());
+    var total_biaya = parseFloat($('#total_biaya_text').val());
+    if(isNaN(total_hpp)) total_hpp = 0;
+    if(isNaN(total_biaya)) total_biaya = 0;
+    var total_cost = total_hpp + total_biaya;
+
+    if(total_cost <= 0){
+      alert('Total biaya bahan + beban masih 0. Harap isi data bahan dan/atau beban terlebih dahulu.');
+      return;
+    }
+
+    // Kumpulkan semua hasil row yang memiliki produk dan jumlah
+    var hasil_rows = [];
+    $('.searching_produk_nama_hasil').each(function(i, el){
+      var tr = $(el).closest('tr');
+      var nama = $(el).val();
+      var jumlah = parseFloat(tr.find('.jumlah_produk_hasil').val());
+      if(nama != '' && !isNaN(jumlah) && jumlah > 0){
+        hasil_rows.push({
+          tr: tr,
+          nama: nama,
+          jumlah: jumlah
+        });
+      }
+    });
+
+    if(hasil_rows.length === 0){
+      alert('Harap isi minimal satu produk hasil dengan jumlah.');
+      return;
+    }
+
+    // Hitung total jumlah hasil
+    var total_jumlah = 0;
+    $.each(hasil_rows, function(i, row){ total_jumlah += row.jumlah; });
+
+    // HPP per unit
+    var hpp_per_unit = total_cost / total_jumlah;
+    // Cek apakah pembagian bersih (integer atau desimal pendek tidak berulang)
+    var hpp_rounded = Math.round(hpp_per_unit * 100) / 100;
+    var total_check = Math.round(hpp_rounded * total_jumlah * 100) / 100;
+    var selisih = Math.abs(total_cost - total_check);
+
+    // Jika selisih sangat kecil (toleransi pembulatan), anggap bersih
+    if(selisih < 0.02){
+      // Langsung isi HPP
+      $.each(hasil_rows, function(i, row){
+        row.tr.find('.harga_pokok_text').val(hpp_rounded);
+        count_subtotal_hpp_hasil(row.tr);
+      });
+      count_total_hpp_hasil();
+      return;
+    }
+
+    // Jika tidak bersih, tampilkan modal pembulatan
+    // HPP dibulatkan ke atas (ceil ke integer)
+    var hpp_bulat = Math.ceil(hpp_per_unit);
+    var total_bulat = hpp_bulat * total_jumlah;
+    var biaya_pembulatan = Math.round((total_bulat - total_cost) * 100) / 100;
+
+    // Isi data modal
+    $('#modal_total_biaya').text(currency_formated(total_cost));
+    $('#modal_jumlah_hasil').text(total_jumlah);
+    $('#modal_hpp_desimal').text(currency_formated(hpp_rounded));
+    $('#modal_hpp_bulat').text(currency_formated(hpp_bulat));
+    $('#modal_biaya_pembulatan').text(currency_formated(biaya_pembulatan));
+    $('#modal_total_setelah_bulat').text(currency_formated(total_bulat));
+
+    // Simpan data untuk digunakan saat konfirmasi
+    $('#modal_hitung_hpp').data('hasil_rows', hasil_rows);
+    $('#modal_hitung_hpp').data('hpp_rounded', hpp_rounded);
